{
  "name": "cctns-agra-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CCTNS AGRA Verification Portal Monorepo",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "start:server": "npm run start --prefix server",
    "dev:server": "npm run dev --prefix server",
    "start:client": "npm run start --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run start:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
